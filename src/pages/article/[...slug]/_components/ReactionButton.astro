---
export type Props = {
  class?: string;
};

const { class: className = "" } = Astro.props;
---

<div class="relative inline-block text-left">
  <!-- Trigger Button -->
  <button
    id="reaction-popover-btn"
    type="button"
    class:list={[
      "inline-flex items-center gap-2 rounded-lg border border-border/80 bg-background/80 px-3.5 py-1.5 text-xs font-semibold text-foreground shadow-xs transition-all hover:border-accent hover:bg-accent/10 hover:text-accent focus:outline-none cursor-pointer",
      className,
    ]}
    title="Add reaction to article"
    aria-expanded="false"
    aria-haspopup="true"
  >
    <svg
      aria-hidden="true"
      focusable="false"
      viewBox="0 0 16 16"
      width="15"
      height="15"
      fill="currentColor"
      class="octicon octicon-smiley text-accent"
    >
      <path
        d="M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0ZM1.5 8a6.5 6.5 0 1 0 13 0 6.5 6.5 0 0 0-13 0Zm3.82 1.636a.75.75 0 0 1 1.038.175l.007.009c.103.118.22.222.35.31.264.178.683.37 1.285.37.602 0 1.02-.192 1.285-.371.13-.088.247-.192.35-.31l.007-.008a.75.75 0 0 1 1.222.87l-.022-.015c.02.013.021.015.021.015v.001l-.001.002-.002.003-.005.007-.014.019a2.066 2.066 0 0 1-.184.213c-.16.166-.338.316-.53.445-.63.418-1.37.638-2.127.629-.946 0-1.652-.308-2.126-.63a3.331 3.331 0 0 1-.715-.657l-.014-.02-.005-.006-.002-.003v-.002h-.001l.613-.432-.614.43a.75.75 0 0 1 .183-1.044ZM12 7a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM5 8a1 1 0 1 1 0-2 1 1 0 0 1 0 2Zm5.25 2.25.592.416a97.71 97.71 0 0 0-.592-.416Z"
      ></path>
    </svg>
    <span id="selected-reaction-label">React</span>
  </button>

  <!-- Reaction Popover Menu -->
  <div
    id="reaction-popover-menu"
    class="absolute end-0 bottom-full mb-2 hidden w-64 rounded-xl border border-border bg-background p-3 shadow-xl z-50 backdrop-blur-md"
  >
    <div class="flex items-center justify-between px-1 mb-2">
      <p class="text-xs font-semibold text-muted-foreground">Pick your reaction</p>
      <span class="text-[10px] text-accent font-mono">Giscus</span>
    </div>
    <div class="border-t border-border/60 mb-2"></div>
    <div class="grid grid-cols-4 gap-1.5 text-center">
      <button
        type="button"
        data-emoji="👍"
        title="Add +1 reaction"
        class="emoji-btn rounded-lg p-2 text-xl hover:bg-muted/70 transition-all hover:scale-125 cursor-pointer"
        >👍</button
      >
      <button
        type="button"
        data-emoji="👎"
        title="Add -1 reaction"
        class="emoji-btn rounded-lg p-2 text-xl hover:bg-muted/70 transition-all hover:scale-125 cursor-pointer"
        >👎</button
      >
      <button
        type="button"
        data-emoji="😄"
        title="Add Laugh reaction"
        class="emoji-btn rounded-lg p-2 text-xl hover:bg-muted/70 transition-all hover:scale-125 cursor-pointer"
        >😄</button
      >
      <button
        type="button"
        data-emoji="🎉"
        title="Add Hooray reaction"
        class="emoji-btn rounded-lg p-2 text-xl hover:bg-muted/70 transition-all hover:scale-125 cursor-pointer"
        >🎉</button
      >
      <button
        type="button"
        data-emoji="😕"
        title="Add Confused reaction"
        class="emoji-btn rounded-lg p-2 text-xl hover:bg-muted/70 transition-all hover:scale-125 cursor-pointer"
        >😕</button
      >
      <button
        type="button"
        data-emoji="❤️"
        title="Add Love reaction"
        class="emoji-btn rounded-lg p-2 text-xl hover:bg-muted/70 transition-all hover:scale-125 cursor-pointer"
        >❤️</button
      >
      <button
        type="button"
        data-emoji="🚀"
        title="Add Rocket reaction"
        class="emoji-btn rounded-lg p-2 text-xl hover:bg-muted/70 transition-all hover:scale-125 cursor-pointer"
        >🚀</button
      >
      <button
        type="button"
        data-emoji="👀"
        title="Add Eyes reaction"
        class="emoji-btn rounded-lg p-2 text-xl hover:bg-muted/70 transition-all hover:scale-125 cursor-pointer"
        >👀</button
      >
    </div>
  </div>
</div>

<script>
  function setupReactionMenu() {
    const btn = document.getElementById("reaction-popover-btn");
    const menu = document.getElementById("reaction-popover-menu");
    const label = document.getElementById("selected-reaction-label");
    if (!btn || !menu) return;

    function toggleMenu() {
      if (!menu || !btn) return;
      const isHidden = menu.classList.contains("hidden");
      if (isHidden) {
        menu.classList.remove("hidden");
        btn.setAttribute("aria-expanded", "true");
      } else {
        closeMenu();
      }
    }

    function closeMenu() {
      menu?.classList.add("hidden");
      btn?.setAttribute("aria-expanded", "false");
    }

    btn.onclick = (e) => {
      e.stopPropagation();
      toggleMenu();
    };

    document.addEventListener("click", (e) => {
      if (menu && !menu.contains(e.target as Node) && e.target !== btn) {
        closeMenu();
      }
    });

    const emojiBtns = menu.querySelectorAll(".emoji-btn");
    emojiBtns.forEach((emojiBtn) => {
      emojiBtn.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const emoji = target.getAttribute("data-emoji");
        if (emoji && label) {
          label.textContent = `Reacted ${emoji}`;
        }
        closeMenu();

        // Scroll to Giscus discussion section smoothly so reaction is saved
        const commentsSec = document.getElementById("comments");
        if (commentsSec) {
          commentsSec.scrollIntoView({ behavior: "smooth" });
        }
      });
    });
  }

  setupReactionMenu();
  document.addEventListener("astro:after-swap", setupReactionMenu);
</script>
