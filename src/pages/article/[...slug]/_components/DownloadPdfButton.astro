---
export type Props = {
  class?: string;
};

const { class: className = "" } = Astro.props;
---

<button
  id="download-pdf-btn"
  type="button"
  data-pagefind-ignore
  class:list={[
    "inline-flex items-center gap-2 rounded-lg border border-border/80 bg-background/80 px-3.5 py-1.5 text-xs font-semibold text-foreground shadow-xs transition-all hover:border-accent hover:bg-accent/10 hover:text-accent focus:outline-none cursor-pointer",
    className,
  ]}
  title="Download or Save Article as PDF"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="15"
    height="15"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
    <polyline points="7 10 12 15 17 10"></polyline>
    <line x1="12" y1="15" x2="12" y2="3"></line>
  </svg>
  <span>Download PDF</span>
</button>

<script>
  const MAX_PDF_TITLE_CHARS = 50;

  function getCappedPdfTitle(fullTitle: string, maxLen = MAX_PDF_TITLE_CHARS): string {
    if (!fullTitle) return fullTitle;
    const parts = fullTitle.split("|");
    const siteName = parts.length > 1 ? parts[parts.length - 1].trim() : "";
    const mainTitle = parts.slice(0, parts.length > 1 ? -1 : undefined).join("|").trim();

    if (mainTitle.length <= maxLen) return fullTitle;

    const truncated = mainTitle.slice(0, maxLen).trimEnd() + "…";
    return siteName ? `${truncated} | ${siteName}` : truncated;
  }

  let originalTitle = "";

  function preparePrintTitle() {
    if (!originalTitle) {
      originalTitle = document.title;
    }
    document.title = getCappedPdfTitle(originalTitle);
  }

  function restorePrintTitle() {
    if (originalTitle) {
      document.title = originalTitle;
      originalTitle = "";
    }
  }

  if (typeof window !== "undefined") {
    window.addEventListener("beforeprint", preparePrintTitle);
    window.addEventListener("afterprint", restorePrintTitle);
  }

  function setupPdfDownload() {
    const btn = document.getElementById("download-pdf-btn");
    if (!btn) return;

    btn.onclick = () => {
      preparePrintTitle();
      window.print();
      // Fallback restore in case afterprint doesn't fire immediately
      setTimeout(restorePrintTitle, 1500);
    };
  }

  setupPdfDownload();
  document.addEventListener("astro:after-swap", setupPdfDownload);
</script>
