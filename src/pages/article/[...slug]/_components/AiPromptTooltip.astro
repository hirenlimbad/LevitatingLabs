---
type Props = {
  articleTitle: string;
  articleUrl: string;
};

const { articleTitle, articleUrl } = Astro.props;

const promptText = `Analyze and discuss the key findings from the article "${articleTitle}" at ${articleUrl}`;
const encodedPrompt = encodeURIComponent(promptText);

const chatGptUrl = `https://chatgpt.com/?q=${encodedPrompt}`;
const claudeUrl = `https://claude.ai/new?q=${encodedPrompt}`;
---

<div class="relative inline-block text-left" id="ai-prompt-wrapper" data-pagefind-ignore>
  <!-- Anchor / Trigger Link -->
  <button
    id="ai-prompt-btn"
    type="button"
    class="inline-flex items-center gap-1.5 text-xs font-semibold text-accent hover:underline focus:outline-none cursor-pointer"
    aria-expanded="false"
    aria-haspopup="true"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="inline-block text-accent"
    >
      <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path>
    </svg>
    <span>Discuss with AI ✦</span>
  </button>

  <!-- Mobile Backdrop -->
  <div
    id="ai-prompt-backdrop"
    class="hidden fixed inset-0 z-40 bg-black/60 backdrop-blur-xs sm:hidden"
  ></div>

  <!-- Tooltip / Mobile Pop-up Dialog -->
  <div
    id="ai-prompt-modal"
    class="hidden z-50 p-4 rounded-xl border border-border/80 bg-background shadow-2xl backdrop-blur-md transition-all duration-200
           fixed inset-x-4 top-1/2 -translate-y-1/2 max-w-sm mx-auto
           sm:absolute sm:inset-auto sm:left-0 sm:top-full sm:mt-2 sm:translate-y-0 sm:w-96 sm:max-w-none"
  >
    <div class="mb-2.5 flex items-center justify-between border-b border-border/50 pb-2">
      <div class="flex items-center gap-1.5">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-accent"
        >
          <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path>
        </svg>
        <span class="text-xs font-bold uppercase tracking-wider text-muted-foreground">
          Discuss Article with AI
        </span>
      </div>
      <button
        id="ai-prompt-close"
        type="button"
        class="text-muted-foreground hover:text-foreground text-base leading-none p-1 cursor-pointer"
        aria-label="Close dialog"
      >
        &#10005;
      </button>
    </div>

    <!-- Prompt Box -->
    <div class="relative my-2.5 rounded-lg border border-border/70 bg-muted/40 p-3 text-xs leading-relaxed text-foreground">
      <p id="ai-prompt-content" class="select-all font-mono break-words">
        {promptText}
      </p>
      <button
        id="ai-copy-btn"
        type="button"
        class="mt-2.5 flex items-center gap-1.5 rounded-md border border-border/80 bg-background px-2.5 py-1.5 text-xs font-medium text-foreground hover:border-accent hover:text-accent cursor-pointer transition-colors active:scale-95"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
        <span id="ai-copy-text">Copy Prompt</span>
      </button>
    </div>

    <!-- Dynamic AI Redirection Links -->
    <div class="mt-3 flex items-center justify-between sm:justify-start sm:gap-2">
      <span class="text-[11px] font-medium text-muted-foreground">Open in:</span>
      <div class="flex flex-wrap items-center gap-2">
        <a
          href={chatGptUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg border border-border/80 bg-muted/50 px-3 py-1.5 text-xs font-medium text-foreground hover:border-emerald-500 hover:text-emerald-500 transition-colors"
        >
          ChatGPT ↗
        </a>
        <a
          href={claudeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg border border-border/80 bg-muted/50 px-3 py-1.5 text-xs font-medium text-foreground hover:border-amber-500 hover:text-amber-500 transition-colors"
        >
          Claude ↗
        </a>
      </div>
    </div>
  </div>
</div>

<script is:inline data-astro-rerun>
  function initAiPromptTooltip() {
    const btn = document.getElementById("ai-prompt-btn");
    const modal = document.getElementById("ai-prompt-modal");
    const backdrop = document.getElementById("ai-prompt-backdrop");
    const closeBtn = document.getElementById("ai-prompt-close");
    const copyBtn = document.getElementById("ai-copy-btn");
    const copyText = document.getElementById("ai-copy-text");
    const promptContent = document.getElementById("ai-prompt-content");

    if (!btn || !modal) return;

    function toggleModal(e) {
      e?.stopPropagation();
      const isHidden = modal.classList.contains("hidden");
      if (isHidden) {
        modal.classList.remove("hidden");
        backdrop?.classList.remove("hidden");
        btn.setAttribute("aria-expanded", "true");
      } else {
        closeModal();
      }
    }

    function closeModal() {
      modal.classList.add("hidden");
      backdrop?.classList.add("hidden");
      btn.setAttribute("aria-expanded", "false");
    }

    btn.addEventListener("click", toggleModal);
    closeBtn?.addEventListener("click", closeModal);
    backdrop?.addEventListener("click", closeModal);

    document.addEventListener("click", (e) => {
      if (!modal.contains(e.target) && e.target !== btn) {
        closeModal();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeModal();
    });

    copyBtn?.addEventListener("click", async () => {
      if (!promptContent) return;
      await navigator.clipboard.writeText(promptContent.innerText.trim());
      if (copyText) {
        copyText.innerText = "Copied!";
        setTimeout(() => {
          copyText.innerText = "Copy Prompt";
        }, 1200);
      }
    });
  }

  initAiPromptTooltip();
</script>
