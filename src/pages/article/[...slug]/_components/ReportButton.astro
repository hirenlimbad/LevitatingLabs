---
type Props = {
  postTitle: string;
  postUrl: string;
};

const { postTitle, postUrl } = Astro.props;
const formspreeEndpoint = "https://formspree.io/f/xaeyyner";
---

<!-- Trigger Button -->
<button
  type="button"
  id="open-report-modal-btn"
  data-pagefind-ignore
  class="group inline-flex items-center gap-2 rounded-full border border-border/80 bg-accent/5 px-3.5 py-1.5 text-xs text-muted-foreground transition-all hover:border-accent hover:bg-accent/10 hover:text-accent focus-outline cursor-pointer"
  title="Report a discrepancy or send feedback about this post"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="stroke-current transition-transform group-hover:scale-110"
  >
    <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path>
    <line x1="4" y1="22" x2="4" y2="15"></line>
  </svg>
  <span class="font-medium">Report Discrepancy / Feedback</span>
</button>

<!-- Modal Backdrop & Popup -->
<div
  id="report-modal"
  data-pagefind-ignore
  class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/70 p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="report-modal-title"
>
  <div class="relative w-full max-w-md rounded-xl border border-border bg-background p-6 shadow-2xl transition-all sm:p-7">
    <!-- Close Button -->
    <button
      type="button"
      id="close-report-modal-btn"
      class="absolute top-4 right-4 rounded-lg p-1.5 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
      aria-label="Close modal"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Header -->
    <div class="mb-4">
      <h2 id="report-modal-title" class="text-base font-bold text-foreground sm:text-lg">
        Report Discrepancy / Feedback
      </h2>
      <p class="mt-1 text-xs text-muted-foreground leading-relaxed">
        Help us maintain research integrity. Reports are reviewed directly by Levitating Labs.
      </p>
    </div>

    <!-- Formspree Form -->
    <form id="report-form" action={formspreeEndpoint} method="POST" class="space-y-4">
      <!-- Hidden Post Metadata -->
      <input type="hidden" name="post_title" value={postTitle} />
      <input type="hidden" name="post_url" value={postUrl} />

      <!-- Post Badge -->
      <div class="rounded-lg border border-border/60 bg-muted/40 p-2.5 text-xs text-muted-foreground">
        <span class="font-semibold text-foreground">Target Post:</span> {postTitle}
      </div>

      <!-- Category Radio Buttons -->
      <div>
        <label class="block text-xs font-medium text-foreground mb-2">
          Issue Category <span class="text-accent">*</span>
        </label>
        <div class="space-y-1.5 text-xs">
          <label class="flex items-center gap-2.5 rounded-lg border border-border/60 bg-muted/20 px-3 py-2 cursor-pointer transition-colors hover:border-accent/50 hover:bg-accent/5">
            <input
              type="radio"
              name="category"
              value="Scientific / Computational Discrepancy"
              checked
              required
              class="accent-accent text-accent focus:ring-accent cursor-pointer"
            />
            <span class="text-foreground font-medium">Scientific / Computational Discrepancy</span>
          </label>
          <label class="flex items-center gap-2.5 rounded-lg border border-border/60 bg-muted/20 px-3 py-2 cursor-pointer transition-colors hover:border-accent/50 hover:bg-accent/5">
            <input
              type="radio"
              name="category"
              value="Typo / Formatting Error"
              class="accent-accent text-accent focus:ring-accent cursor-pointer"
            />
            <span class="text-foreground font-medium">Typo / Formatting Error</span>
          </label>
          <label class="flex items-center gap-2.5 rounded-lg border border-border/60 bg-muted/20 px-3 py-2 cursor-pointer transition-colors hover:border-accent/50 hover:bg-accent/5">
            <input
              type="radio"
              name="category"
              value="Broken Link / Asset"
              class="accent-accent text-accent focus:ring-accent cursor-pointer"
            />
            <span class="text-foreground font-medium">Broken Link / Asset</span>
          </label>
          <label class="flex items-center gap-2.5 rounded-lg border border-border/60 bg-muted/20 px-3 py-2 cursor-pointer transition-colors hover:border-accent/50 hover:bg-accent/5">
            <input
              type="radio"
              name="category"
              value="General Question / Feedback"
              class="accent-accent text-accent focus:ring-accent cursor-pointer"
            />
            <span class="text-foreground font-medium">General Question / Feedback</span>
          </label>
        </div>
      </div>

      <!-- Email (Optional) -->
      <div>
        <label for="email" class="block text-xs font-medium text-foreground mb-1">
          Your Email <span class="text-muted-foreground font-normal">(optional, for follow-up)</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="researcher@example.com"
          class="w-full rounded-lg border border-border bg-background px-3 py-2 text-xs text-foreground focus:border-accent focus:outline-none"
        />
      </div>

      <!-- Message Textarea -->
      <div>
        <label for="message" class="block text-xs font-medium text-foreground mb-1">
          Discrepancy Details <span class="text-accent">*</span>
        </label>
        <textarea
          id="message"
          name="message"
          rows="4"
          required
          placeholder="Describe the discrepancy, calculation error, or feedback in detail..."
          class="w-full rounded-lg border border-border bg-background px-3 py-2 text-xs text-foreground focus:border-accent focus:outline-none resize-none"
        ></textarea>
      </div>

      <!-- Status Notification -->
      <div id="report-form-status" class="hidden rounded-lg p-2.5 text-xs text-center font-medium"></div>

      <!-- Action Buttons -->
      <div class="flex items-center justify-end gap-2 pt-1">
        <button
          type="button"
          id="cancel-report-btn"
          class="rounded-lg border border-border px-3.5 py-1.5 text-xs font-medium text-muted-foreground hover:bg-muted hover:text-foreground transition-colors cursor-pointer"
        >
          Cancel
        </button>
        <button
          type="submit"
          id="submit-report-btn"
          class="rounded-lg bg-accent px-4 py-1.5 text-xs font-medium text-accent-foreground transition-opacity hover:opacity-90 disabled:opacity-50 cursor-pointer"
        >
          Submit Discrepancy
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function setupReportModal() {
    const openBtn = document.querySelector("#open-report-modal-btn");
    const closeBtn = document.querySelector("#close-report-modal-btn");
    const cancelBtn = document.querySelector("#cancel-report-btn");
    const modal = document.querySelector("#report-modal");
    const form = document.querySelector("#report-form") as HTMLFormElement | null;
    const statusDiv = document.querySelector("#report-form-status");
    const submitBtn = document.querySelector("#submit-report-btn") as HTMLButtonElement | null;

    if (!openBtn || !modal || !form) return;

    function openModal() {
      modal?.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }

    function closeModal() {
      modal?.classList.add("hidden");
      document.body.style.overflow = "";
      if (statusDiv) {
        statusDiv.classList.add("hidden");
        statusDiv.textContent = "";
      }
    }

    openBtn.addEventListener("click", openModal);
    closeBtn?.addEventListener("click", closeModal);
    cancelBtn?.addEventListener("click", closeModal);

    modal.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.classList.contains("hidden")) {
        closeModal();
      }
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!submitBtn || !statusDiv) return;

      submitBtn.disabled = true;
      submitBtn.textContent = "Submitting...";
      statusDiv.className = "rounded-lg p-2.5 text-xs text-center font-medium bg-muted/60 text-muted-foreground";
      statusDiv.classList.remove("hidden");
      statusDiv.textContent = "Submitting discrepancy to Levitating Labs...";

      try {
        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: "POST",
          body: formData,
          headers: {
            Accept: "application/json",
          },
        });

        if (response.ok) {
          statusDiv.className = "rounded-lg p-2.5 text-xs text-center font-medium bg-green-500/15 text-green-400 border border-green-500/30";
          statusDiv.textContent = "✓ Report submitted successfully. Thank you!";
          form.reset();
          setTimeout(() => {
            closeModal();
            submitBtn.disabled = false;
            submitBtn.textContent = "Submit Discrepancy";
          }, 2000);
        } else {
          throw new Error("Form submission failed");
        }
      } catch (error) {
        statusDiv.className = "rounded-lg p-2.5 text-xs text-center font-medium bg-red-500/15 text-red-400 border border-red-500/30";
        statusDiv.textContent = "✕ Unable to submit. Please check your connection.";
        submitBtn.disabled = false;
        submitBtn.textContent = "Submit Discrepancy";
      }
    });
  }

  setupReportModal();
  document.addEventListener("astro:after-swap", setupReportModal);
</script>
