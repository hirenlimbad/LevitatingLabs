---
import IconArrowNarrowUp from "@/assets/icons/IconArrowNarrowUp.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import { useTranslations } from "@/i18n";
import config from "@/config";

const t = useTranslations(Astro.currentLocale);
const { features } = config;
---

<div
  id="floating-actions-container"
  class="fixed bottom-6 end-4 sm:end-6 z-30 flex items-center gap-2.5 print:hidden"
>
  {
    features.lightAndDarkMode && (
      <button
        id="floating-theme-btn"
        data-button="theme"
        aria-label={t.a11y.toggleTheme}
        title={t.a11y.toggleTheme}
        aria-live="polite"
        class:list={[
          "theme-btn flex size-12 items-center justify-center gap-2 rounded-xl border border-border/70 bg-background/90 text-foreground backdrop-blur-md shadow-md pointer-events-auto cursor-pointer",
          "md:h-10 md:w-auto md:px-3.5",
          "hover:border-accent hover:text-accent transition-colors duration-200",
        ]}
      >
        <div class="relative size-5 flex items-center justify-center pointer-events-none">
          <IconMoon class="absolute inset-0 size-5 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
          <IconSunHigh class="absolute inset-0 size-5 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
        </div>
        <span class="hidden text-xs font-semibold md:inline pointer-events-none">
          Theme
        </span>
      </button>
    )
  }

  <button
    data-button="comments"
    aria-label="Discussion"
    title="Jump to discussion"
    class:list={[
      "flex size-12 items-center justify-center gap-2 rounded-xl border border-border/70 bg-background/90 text-foreground backdrop-blur-md shadow-md pointer-events-auto cursor-pointer",
      "md:h-10 md:w-auto md:px-3.5",
      "hover:border-accent hover:text-accent transition-colors duration-200",
    ]}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-5 pointer-events-none"
    >
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
    <span class="hidden text-xs font-semibold md:inline pointer-events-none">
      Discussion
    </span>
  </button>

  <button
    data-button="back-to-top"
    aria-label={t.post.backToTop}
    title={t.post.backToTop}
    class:list={[
      "flex size-12 items-center justify-center gap-2 rounded-xl border border-border/70 bg-background/90 text-foreground backdrop-blur-md shadow-md cursor-pointer",
      "md:h-10 md:w-auto md:px-3.5",
      "hover:border-accent hover:text-accent transition-all duration-300",
      "opacity-0 translate-y-4 pointer-events-none hidden",
    ]}
  >
    <IconArrowNarrowUp class="size-5 pointer-events-none" />
    <span class="hidden text-xs font-semibold md:inline pointer-events-none">
      {t.post.backToTop}
    </span>
  </button>
</div>

<script is:inline data-astro-rerun>
  function initFloatingActions() {
    const rootElement = document.documentElement;
    const backToTopBtn = document.querySelector("[data-button='back-to-top']");
    const commentsBtn = document.querySelector("[data-button='comments']");
    const floatingThemeBtn = document.querySelector("#floating-theme-btn");

    if (!rootElement) return;

    if (floatingThemeBtn && !floatingThemeBtn.hasAttribute("data-theme-listener")) {
      floatingThemeBtn.setAttribute("data-theme-listener", "true");
      floatingThemeBtn.addEventListener("click", () => {
        if (typeof window.toggleTheme === "function") {
          window.toggleTheme();
        } else {
          const headerThemeBtn = document.querySelector("#theme-btn");
          headerThemeBtn?.click();
        }
      });
    }

    backToTopBtn?.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    commentsBtn?.addEventListener("click", () => {
      const commentsSection = document.getElementById("comments") || document.querySelector(".giscus");
      if (commentsSection) {
        commentsSection.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });

    let lastVisible = null;
    function handleScroll() {
      const scrollTotal = rootElement.scrollHeight - rootElement.clientHeight;
      const scrollTop = rootElement.scrollTop;
      const isVisible = scrollTotal > 0 && scrollTop / scrollTotal > 0.15;

      if (isVisible !== lastVisible) {
        if (backToTopBtn) {
          if (isVisible) {
            backToTopBtn.classList.remove("hidden");
            requestAnimationFrame(() => {
              backToTopBtn.classList.add("opacity-100", "translate-y-0", "pointer-events-auto");
              backToTopBtn.classList.remove("opacity-0", "translate-y-4", "pointer-events-none");
            });
          } else {
            backToTopBtn.classList.add("opacity-0", "translate-y-4", "pointer-events-none");
            backToTopBtn.classList.remove("opacity-100", "translate-y-0", "pointer-events-auto");
            setTimeout(() => {
              if (lastVisible === false) {
                backToTopBtn.classList.add("hidden");
              }
            }, 300);
          }
        }
        lastVisible = isVisible;
      }
    }

    let ticking = false;
    document.addEventListener("scroll", () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          handleScroll();
          ticking = false;
        });
        ticking = true;
      }
    });

    handleScroll();
  }
  initFloatingActions();
</script>
