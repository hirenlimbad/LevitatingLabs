---
import IconArrowNarrowUp from "@/assets/icons/IconArrowNarrowUp.svg";
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.currentLocale);
---

<div
  id="floating-actions-container"
  class="fixed bottom-6 end-6 z-50 flex items-center gap-2"
>
  <button
    data-button="comments"
    aria-label="Discussion"
    title="Jump to discussion"
    class:list={[
      "flex size-10 items-center justify-center gap-1.5 rounded-lg border border-border/70 bg-background/80 text-foreground backdrop-blur-sm shadow-xs pointer-events-auto cursor-pointer",
      "md:h-9 md:w-auto md:px-3",
      "hover:border-accent hover:text-accent transition-colors duration-200",
    ]}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-4"
    >
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
    <span class="hidden text-xs font-medium md:inline">
      Discussion
    </span>
  </button>

  <button
    data-button="back-to-top"
    aria-label={t.post.backToTop}
    title={t.post.backToTop}
    class:list={[
      "flex size-10 items-center justify-center gap-1.5 rounded-lg border border-border/70 bg-background/80 text-foreground backdrop-blur-sm shadow-xs cursor-pointer",
      "md:h-9 md:w-auto md:px-3",
      "hover:border-accent hover:text-accent transition-all duration-300",
      "opacity-0 translate-y-4 pointer-events-none hidden",
    ]}
  >
    <IconArrowNarrowUp class="size-4" />
    <span class="hidden text-xs font-medium md:inline">
      {t.post.backToTop}
    </span>
  </button>
</div>

<script is:inline data-astro-rerun>
  function initFloatingActions() {
    const rootElement = document.documentElement;
    const backToTopBtn = document.querySelector("[data-button='back-to-top']");
    const commentsBtn = document.querySelector("[data-button='comments']");

    if (!rootElement) return;

    backToTopBtn?.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    commentsBtn?.addEventListener("click", () => {
      const commentsSection = document.getElementById("comments") || document.querySelector(".giscus");
      if (commentsSection) {
        commentsSection.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });

    let lastVisible = null;
    function handleScroll() {
      const scrollTotal = rootElement.scrollHeight - rootElement.clientHeight;
      const scrollTop = rootElement.scrollTop;
      const isVisible = scrollTotal > 0 && scrollTop / scrollTotal > 0.15;

      if (isVisible !== lastVisible) {
        if (backToTopBtn) {
          if (isVisible) {
            backToTopBtn.classList.remove("hidden");
            requestAnimationFrame(() => {
              backToTopBtn.classList.add("opacity-100", "translate-y-0", "pointer-events-auto");
              backToTopBtn.classList.remove("opacity-0", "translate-y-4", "pointer-events-none");
            });
          } else {
            backToTopBtn.classList.add("opacity-0", "translate-y-4", "pointer-events-none");
            backToTopBtn.classList.remove("opacity-100", "translate-y-0", "pointer-events-auto");
            setTimeout(() => {
              if (lastVisible === false) {
                backToTopBtn.classList.add("hidden");
              }
            }, 300);
          }
        }
        lastVisible = isVisible;
      }
    }

    let ticking = false;
    document.addEventListener("scroll", () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          handleScroll();
          ticking = false;
        });
        ticking = true;
      }
    });

    handleScroll();
  }
  initFloatingActions();
</script>
