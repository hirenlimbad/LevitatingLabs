---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl mb-4">
        Welcome to Levitating Labs!
      </h1>
      <p class="text-lg leading-relaxed">
        Levitating Labs is an open research notebook dedicated to <strong>AI in drug discovery</strong>. 
        We share focused findings, computational breakdowns, and methodological insights in real time—bypassing 
        the latency of traditional journal submission cycles.
      </p>

      <div class="mt-6">
        <h2 class="text-sm font-semibold tracking-wider text-accent uppercase mb-3">
          Lab Rules & Core Principles
        </h2>
        <ul class="space-y-3 text-sm sm:text-base">
          <li class="flex items-start gap-2">
            <span class="text-accent font-bold">1.</span>
            <span><strong>No Shortcut Evaluation:</strong> Evaluation data is strictly leakage-free: conformer generation, molecular scaffold, and train/test splits are kept physically disjoint.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-accent font-bold">2.</span>
            <span><strong>Standardized Baselines:</strong> Every experiment is benchmarked against established baselines—ensuring honest, transparent reporting even when there is no performance gain.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-accent font-bold">3.</span>
            <span><strong>First-Principles Research:</strong> We prioritize solving fundamental scientific bottlenecks over chasing minor hyperparameter gains on saturated benchmarks.</span>
          </li>
        </ul>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
