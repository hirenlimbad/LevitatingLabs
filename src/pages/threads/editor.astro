---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import config from "@/config";

const isDev = import.meta.env.DEV;
const locale = Astro.currentLocale ?? config.site.lang;

const threads = isDev ? await getCollection("threads") : [];
const sortedThreads = threads.sort((a, b) => {
  const dateA = a.data.modDatetime ?? a.data.pubDatetime;
  const dateB = b.data.modDatetime ?? b.data.pubDatetime;
  return new Date(dateB).getTime() - new Date(dateA).getTime();
});---

<Layout title="Local Thread Editor (Dev Only)">
  <Header />
  <Breadcrumb />

  <Main pageTitle="Experiment Thread Editor" pageDesc="Split-screen editor for writing Markdown posts with live preview.">
    <div class="mb-6">
      <a
        href={getRelativeLocaleUrl(locale, "threads")}
        class="focus-outline inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-accent transition-colors"
      >
        <IconArrowLeft class="size-4" />
        <span>Back to all threads</span>
      </a>
    </div>

    {!isDev ? (
      <div class="rounded-xl border border-amber-500/30 bg-amber-500/10 p-6 text-center">
        <h2 class="text-xl font-bold text-amber-600 dark:text-amber-400 mb-2">Dev Mode Required</h2>
        <p class="text-sm text-muted-foreground">
          The local thread editor is only available when running <code class="bg-muted px-1.5 py-0.5 rounded text-accent">npm run dev</code> locally on your laptop.
        </p>
      </div>
    ) : (
      <div class="space-y-6" id="editor-app">
        <!-- Notification toast -->
        <div id="toast" class="hidden rounded-xl border p-4 text-sm font-medium transition-all"></div>

        <!-- Mode Switcher Tabs -->
        <div class="flex flex-wrap items-center gap-2 border-b border-border pb-4">
          <button
            id="tab-append"
            class="tab-btn rounded-lg px-4 py-2 text-sm font-semibold transition-colors border border-accent bg-accent text-accent-foreground"
          >
            📝 Append Post to Topic
          </button>
          <button
            id="tab-create"
            class="tab-btn rounded-lg px-4 py-2 text-sm font-semibold transition-colors border border-border bg-background hover:border-accent"
          >
            ➕ Create New Topic
          </button>
          <button
            id="tab-delete"
            class="tab-btn rounded-lg px-4 py-2 text-sm font-semibold transition-colors border border-border bg-background hover:border-red-500 text-red-600 dark:text-red-400"
          >
            🗑️ Delete Topic
          </button>
        </div>

        <!-- Panel 1: Append Post to Topic (Split Screen) -->
        <div id="panel-append" class="rounded-2xl border border-border bg-background/80 p-5 sm:p-6 space-y-5">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-border/60 pb-3">
            <h2 class="text-lg font-bold text-foreground">Append Post to Existing Topic</h2>
            <span class="text-xs text-muted-foreground">Date is automatically fetched on save</span>
          </div>

          <form id="form-append" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div class="sm:col-span-2">
                <label class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1">Select Topic *</label>
                <select
                  name="id"
                  id="select-topic"
                  required
                  class="w-full rounded-xl border border-border bg-background px-4 py-2.5 text-sm text-foreground focus:outline-accent"
                >
                  <option value="">-- Choose a Topic / Experiment --</option>
                  {sortedThreads.map(t => (
                    <option value={t.id} data-status={t.data.status} data-article={t.data.relatedArticle || ""}>
                      [{t.data.status.toUpperCase()}] {t.data.title}
                    </option>
                  ))}
                </select>
              </div>

              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1">Update Status</label>
                <select
                  name="status"
                  id="append-status"
                  class="w-full rounded-xl border border-border bg-background px-4 py-2.5 text-sm text-foreground focus:outline-accent"
                >
                  <option value="in-progress">🧪 In Progress</option>
                  <option value="checkpoint-reached">🎯 Checkpoint Reached</option>
                  <option value="completed">✅ Completed</option>
                  <option value="archived">📦 Archived</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1">Post Title (Optional)</label>
              <input
                type="text"
                name="noteTitle"
                placeholder="e.g. Day 4: Force Gradient Stabilized & Baseline Run"
                class="w-full rounded-xl border border-border bg-background px-4 py-2 text-sm text-foreground focus:outline-accent"
              />
            </div>

            <!-- Split Screen Editor & Live Preview -->
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <label class="block text-xs font-semibold uppercase tracking-wider text-accent">Post Content (Markdown)</label>
                <span id="append-preview-status" class="text-xs text-muted-foreground italic">Live Preview (updates 2s after typing)</span>
              </div>

              <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 items-stretch">
                <!-- Left: Markdown Input Area -->
                <div class="flex flex-col">
                  <textarea
                    id="append-note-input"
                    name="noteBody"
                    required
                    rows="12"
                    placeholder="Write your Markdown post here...
- Bullet points
- **Bold text**
- `code snippets`
> Blockquotes"
                    class="w-full h-full min-h-[280px] rounded-xl border border-border bg-background p-4 text-sm text-foreground font-mono focus:outline-accent resize-y"
                  ></textarea>
                </div>

                <!-- Right: Live Preview Box -->
                <div class="flex flex-col">
                  <div
                    id="append-live-preview"
                    class="thread-content app-prose w-full h-full min-h-[280px] rounded-xl border border-border/80 bg-muted/20 p-4 text-sm overflow-y-auto"
                  >
                    <p class="text-muted-foreground italic text-xs">Your live Markdown preview will appear here 2 seconds after you stop typing...</p>
                  </div>
                </div>
              </div>
            </div>

            <button
              type="submit"
              class="w-full sm:w-auto rounded-xl bg-accent px-6 py-3 text-sm font-semibold text-accent-foreground hover:opacity-90 transition-opacity"
            >
              🚀 Append Post to Topic
            </button>
          </form>
        </div>

        <!-- Panel 2: Create New Topic (Split Screen) -->
        <div id="panel-create" class="hidden rounded-2xl border border-border bg-background/80 p-5 sm:p-6 space-y-5">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-border/60 pb-3">
            <h2 class="text-lg font-bold text-foreground">Create New Topic / Experiment</h2>
            <span class="text-xs text-muted-foreground">Initial Tags and Details set here</span>
          </div>

          <form id="form-create" class="space-y-4">
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1">Topic Title *</label>
              <input
                type="text"
                name="title"
                required
                placeholder="e.g. Experiment 03: Diffusion Model Scaffolding"
                class="w-full rounded-xl border border-border bg-background px-4 py-2.5 text-sm text-foreground focus:outline-accent"
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1">Initial Status</label>
                <select
                  name="status"
                  class="w-full rounded-xl border border-border bg-background px-4 py-2.5 text-sm text-foreground focus:outline-accent"
                >
                  <option value="in-progress">🧪 In Progress</option>
                  <option value="checkpoint-reached">🎯 Checkpoint Reached</option>
                  <option value="completed">✅ Completed</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1">Tags (comma separated) *</label>
                <input
                  type="text"
                  name="tags"
                  required
                  placeholder="ESM2, Binding-Affinity, GNN"
                  class="w-full rounded-xl border border-border bg-background px-4 py-2.5 text-sm text-foreground focus:outline-accent"
                />
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1">Topic Description / Objective *</label>
              <textarea
                name="description"
                required
                rows="2"
                placeholder="Brief summary of what this topic / experiment aims to test."
                class="w-full rounded-xl border border-border bg-background px-4 py-2.5 text-sm text-foreground focus:outline-accent"
              ></textarea>
            </div>

            <!-- Split Screen Editor & Live Preview for Initial Post -->
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <label class="block text-xs font-semibold uppercase tracking-wider text-accent">First Post Content (Markdown)</label>
                <span id="create-preview-status" class="text-xs text-muted-foreground italic">Live Preview (updates 2s after typing)</span>
              </div>

              <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 items-stretch">
                <!-- Left: Markdown Input Area -->
                <div class="flex flex-col">
                  <textarea
                    id="create-note-input"
                    name="initialNoteBody"
                    rows="8"
                    placeholder="Write initial experiment setup post in Markdown..."
                    class="w-full h-full min-h-[220px] rounded-xl border border-border bg-background p-4 text-sm text-foreground font-mono focus:outline-accent resize-y"
                  ></textarea>
                </div>

                <!-- Right: Live Preview Box -->
                <div class="flex flex-col">
                  <div
                    id="create-live-preview"
                    class="thread-content app-prose w-full h-full min-h-[220px] rounded-xl border border-border/80 bg-muted/20 p-4 text-sm overflow-y-auto"
                  >
                    <p class="text-muted-foreground italic text-xs">Initial post preview will appear here 2 seconds after typing...</p>
                  </div>
                </div>
              </div>
            </div>

            <button
              type="submit"
              class="w-full sm:w-auto rounded-xl bg-accent px-6 py-3 text-sm font-semibold text-accent-foreground hover:opacity-90 transition-opacity"
            >
              🚀 Create Topic File on Disk
            </button>
          </form>
        </div>

        <!-- Panel 3: Delete Topic -->
        <div id="panel-delete" class="hidden rounded-2xl border border-red-500/30 bg-background/80 p-6 space-y-5">
          <h2 class="text-lg font-bold text-red-600 dark:text-red-400">Delete Topic File</h2>
          <p class="text-xs sm:text-sm text-muted-foreground">
            Warning: This action will permanently remove the Markdown file from your local <code class="bg-muted px-1.5 py-0.5 rounded text-accent">src/content/threads/</code> directory.
          </p>

          <form id="form-delete" class="space-y-4">
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1">Select Topic to Delete *</label>
              <select
                name="id"
                required
                class="w-full rounded-xl border border-border bg-background px-4 py-2.5 text-sm text-foreground focus:outline-accent"
              >
                <option value="">-- Choose a Topic to Delete --</option>
                {sortedThreads.map(t => (
                  <option value={t.id}>
                    {t.data.title} ({t.id}.md)
                  </option>
                ))}
              </select>
            </div>

            <button
              type="submit"
              class="w-full sm:w-auto rounded-xl bg-red-600 text-white px-6 py-3 text-sm font-semibold hover:bg-red-700 transition-colors"
            >
              🗑️ Delete File Permanently
            </button>
          </form>
        </div>
      </div>
    )}
  </Main>

  <Footer />
</Layout>

<script>
  // Basic Lightweight Markdown Renderer for Live Preview
  function renderBasicMarkdown(src: string): string {
    if (!src || !src.trim()) {
      return '<p class="text-muted-foreground italic text-xs">Type in the left box to see live preview...</p>';
    }

    let html = src
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;");

    // Code blocks ``` ... ```
    html = html.replace(/```([\s\S]*?)```/g, '<pre class="bg-muted p-3 rounded-lg text-xs font-mono overflow-x-auto my-2"><code>$1</code></pre>');

    // Inline code `code`
    html = html.replace(/`([^`]+)`/g, '<code class="bg-muted px-1.5 py-0.5 rounded text-xs text-accent font-mono">$1</code>');

    // Headings #, ##, ###
    html = html.replace(/^### (.*$)/gim, '<h3 class="text-base font-bold text-foreground my-2">$1</h3>');
    html = html.replace(/^## (.*$)/gim, '<h2 class="text-lg font-bold text-accent border-b border-border pb-1 my-3">$1</h2>');
    html = html.replace(/^# (.*$)/gim, '<h1 class="text-xl font-extrabold text-foreground my-3">$1</h1>');

    // Bold **text**
    html = html.replace(/\*\*([^*]+)\*\*/g, '<strong class="font-bold text-foreground">$1</strong>');

    // Italics *text*
    html = html.replace(/\*([^*]+)\*/g, '<em class="italic">$1</em>');

    // Blockquotes > quote
    html = html.replace(/^&gt; (.*$)/gim, '<blockquote class="border-l-4 border-accent pl-3 py-1 italic text-muted-foreground my-2">$1</blockquote>');

    // Unordered lists - item
    html = html.replace(/^\- (.*$)/gim, '<li class="ml-4 list-disc text-sm my-0.5">$1</li>');

    // Paragraphs
    const lines = html.split("\n\n");
    return lines
      .map(p => {
        if (p.startsWith("<h") || p.startsWith("<pre") || p.startsWith("<blockquote") || p.startsWith("<li")) {
          return p;
        }
        return `<p class="my-2 leading-relaxed text-sm">${p.replace(/\n/g, "<br>")}</p>`;
      })
      .join("");
  }

  function setupEditor() {
    const tabAppend = document.getElementById("tab-append");
    const tabCreate = document.getElementById("tab-create");
    const tabDelete = document.getElementById("tab-delete");

    const panelAppend = document.getElementById("panel-append");
    const panelCreate = document.getElementById("panel-create");
    const panelDelete = document.getElementById("panel-delete");

    const toast = document.getElementById("toast");

    function showToast(msg: string, isError = false) {
      if (!toast) return;
      toast.textContent = msg;
      toast.className = `rounded-xl border p-4 text-sm font-medium transition-all ${
        isError
          ? "border-red-500/40 bg-red-500/10 text-red-600 dark:text-red-400"
          : "border-emerald-500/40 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
      }`;
      toast.classList.remove("hidden");
      setTimeout(() => {
        toast.classList.add("hidden");
      }, 6000);
    }

    function switchTab(activeTab: HTMLElement, activePanel: HTMLElement) {
      [tabAppend, tabCreate, tabDelete].forEach(t => {
        if (!t) return;
        t.classList.remove("bg-accent", "text-accent-foreground", "border-accent");
        t.classList.add("bg-background", "border-border");
      });
      [panelAppend, panelCreate, panelDelete].forEach(p => p?.classList.add("hidden"));

      activeTab.classList.add("bg-accent", "text-accent-foreground", "border-accent");
      activeTab.classList.remove("bg-background", "border-border");
      activePanel.classList.remove("hidden");
    }

    tabAppend?.addEventListener("click", () => switchTab(tabAppend!, panelAppend!));
    tabCreate?.addEventListener("click", () => switchTab(tabCreate!, panelCreate!));
    tabDelete?.addEventListener("click", () => switchTab(tabDelete!, panelDelete!));

    // Live Preview 2-Second Debounce Setup
    function setupLivePreview(inputId: string, previewId: string, statusId: string) {
      const inputEl = document.getElementById(inputId) as HTMLTextAreaElement;
      const previewEl = document.getElementById(previewId);
      const statusEl = document.getElementById(statusId);

      if (!inputEl || !previewEl || !statusEl) return;

      let timer: any = null;

      inputEl.addEventListener("input", () => {
        statusEl.textContent = "⏳ Typing detected... preview updates in 2s";
        statusEl.className = "text-xs text-amber-500 font-medium animate-pulse";

        clearTimeout(timer);
        timer = setTimeout(() => {
          previewEl.innerHTML = renderBasicMarkdown(inputEl.value);
          statusEl.textContent = "✅ Live Preview Updated";
          statusEl.className = "text-xs text-emerald-600 dark:text-emerald-400 font-medium";
        }, 2000);
      });
    }

    setupLivePreview("append-note-input", "append-live-preview", "append-preview-status");
    setupLivePreview("create-note-input", "create-live-preview", "create-preview-status");

    // Handle Topic Selection in Append form
    const selectTopic = document.getElementById("select-topic") as HTMLSelectElement;
    const appendStatus = document.getElementById("append-status") as HTMLSelectElement;

    selectTopic?.addEventListener("change", () => {
      const selectedOpt = selectTopic.options[selectTopic.selectedIndex];
      if (selectedOpt && selectedOpt.value) {
        const status = selectedOpt.dataset.status;
        if (status && appendStatus) appendStatus.value = status;
      }
    });

    const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    const apiUrl = `${baseUrl}api/threads`;

    // Form Submissions
    const formAppend = document.getElementById("form-append") as HTMLFormElement;
    formAppend?.addEventListener("submit", async e => {
      e.preventDefault();
      const formData = new FormData(formAppend);
      const data = Object.fromEntries(formData.entries());

      try {
        const res = await fetch(apiUrl, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        const result = await res.json();

        if (res.ok && result.success) {
          showToast(`✅ Appended post to topic ${result.id}! Date auto-fetched. Refreshing...`);
          setTimeout(() => window.location.reload(), 1500);
        } else {
          showToast(`❌ Failed to append post: ${result.error}`, true);
        }
      } catch (err: any) {
        showToast(`❌ Network error: ${err.message}`, true);
      }
    });

    const formCreate = document.getElementById("form-create") as HTMLFormElement;
    formCreate?.addEventListener("submit", async e => {
      e.preventDefault();
      const formData = new FormData(formCreate);
      const data = Object.fromEntries(formData.entries());

      try {
        const res = await fetch(apiUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        const result = await res.json();

        if (res.ok && result.success) {
          showToast(`✅ Created topic src/content/threads/${result.id}.md successfully! Refreshing...`);
          setTimeout(() => window.location.reload(), 1500);
        } else {
          showToast(`❌ Failed to create topic: ${result.error}`, true);
        }
      } catch (err: any) {
        showToast(`❌ Network error: ${err.message}`, true);
      }
    });

    const formDelete = document.getElementById("form-delete") as HTMLFormElement;
    formDelete?.addEventListener("submit", async e => {
      e.preventDefault();
      const formData = new FormData(formDelete);
      const data = Object.fromEntries(formData.entries());

      if (!confirm(`Are you sure you want to delete topic ${data.id}.md?`)) return;

      try {
        const res = await fetch(apiUrl, {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        const result = await res.json();

        if (res.ok && result.success) {
          showToast(`🗑️ Deleted topic ${data.id}.md successfully! Refreshing...`);
          setTimeout(() => window.location.reload(), 1500);
        } else {
          showToast(`❌ Failed to delete topic: ${result.error}`, true);
        }
      } catch (err: any) {
        showToast(`❌ Network error: ${err.message}`, true);
      }
    });
  }

  setupEditor();
  document.addEventListener("astro:after-swap", setupEditor);
</script>
