---
import { getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Datetime from "@/components/Datetime.astro";
import ThreadStatusBadge from "@/components/ThreadStatusBadge.astro";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import config from "@/config";

export async function getStaticPaths() {
  const threads = await getCollection("threads", ({ data }) => !data.draft);

  const sortedThreads = threads.sort((a, b) => {
    const dateA = a.data.modDatetime ?? a.data.pubDatetime;
    const dateB = b.data.modDatetime ?? b.data.pubDatetime;
    return new Date(dateB).getTime() - new Date(dateA).getTime();
  });

  return sortedThreads.map((thread, index) => ({
    params: { slug: thread.id },
    props: {
      thread,
      prevThread:
        index < sortedThreads.length - 1
          ? {
              id: sortedThreads[index + 1].id,
              title: sortedThreads[index + 1].data.title,
            }
          : null,
      nextThread:
        index > 0
          ? {
              id: sortedThreads[index - 1].id,
              title: sortedThreads[index - 1].data.title,
            }
          : null,
    },
  }));
}

const { thread, prevThread, nextThread } = Astro.props;
const { data } = thread;
const { Content } = await render(thread);

const locale = Astro.currentLocale ?? config.site.lang;
const threadsUrl = getRelativeLocaleUrl(locale, "threads");
const articleUrl = data.relatedArticle
  ? getRelativeLocaleUrl(locale, `article/${data.relatedArticle}`)
  : null;
---

<Layout title={`${data.title} | Experiment Thread`}>
  <Header />
  <Breadcrumb />

  <Main pageTitle="" pageDesc="">
    <div class="mb-4">
      <a
        href={threadsUrl}
        class="focus-outline inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-accent transition-colors"
      >
        <IconArrowLeft class="size-4" />
        <span>Back to all threads</span>
      </a>
    </div>

    <!-- Topic Header (Grok Story Clean Layout) -->
    <header class="mb-6 space-y-4">
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground leading-tight inline-flex flex-wrap items-center gap-2.5">
        <span>{data.title}</span>
        <ThreadStatusBadge status={data.status} size="sm" />
      </h1>

      <div class="flex flex-wrap items-center gap-3 text-xs sm:text-sm text-muted-foreground">
        <Datetime
          pubDatetime={data.pubDatetime}
          modDatetime={data.modDatetime}
          size="sm"
        />
      </div>

      <p class="text-base sm:text-lg text-foreground/90 leading-relaxed font-normal">
        {data.description}
      </p>

      <!-- Checkpoint Article link if published -->
      {articleUrl && (data.status === "checkpoint-reached" || data.status === "completed") && (
        <div class="pt-1">
          <a
            href={articleUrl}
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent hover:underline underline-offset-4"
          >
            <span>Read Published Article</span>
            <IconArrowRight class="size-4" />
          </a>
        </div>
      )}



      <div class="border-b border-border pt-4"></div>
    </header>

    <!-- Thread Posts Markdown Body -->
    <article class="thread-content prose dark:prose-invert max-w-none">
      <Content />
    </article>

    <!-- Prev / Next Navigation -->
    <div class="mt-12 flex flex-col sm:flex-row items-stretch justify-between gap-4 pt-6 border-t border-border">
      {prevThread ? (
        <a
          href={getRelativeLocaleUrl(locale, `threads/${prevThread.id}`)}
          class="flex-1 rounded-xl border border-border p-4 hover:border-accent/50 hover:bg-accent/5 transition-all text-left"
        >
          <span class="text-xs text-muted-foreground flex items-center gap-1 mb-1">
            <IconArrowLeft class="size-3.5" /> Previous Thread
          </span>
          <span class="font-medium text-sm text-foreground line-clamp-1">{prevThread.title}</span>
        </a>
      ) : (
        <div class="flex-1"></div>
      )}

      {nextThread ? (
        <a
          href={getRelativeLocaleUrl(locale, `threads/${nextThread.id}`)}
          class="flex-1 rounded-xl border border-border p-4 hover:border-accent/50 hover:bg-accent/5 transition-all text-right"
        >
          <span class="text-xs text-muted-foreground flex items-center justify-end gap-1 mb-1">
            Next Thread <IconArrowRight class="size-3.5" />
          </span>
          <span class="font-medium text-sm text-foreground line-clamp-1">{nextThread.title}</span>
        </a>
      ) : (
        <div class="flex-1"></div>
      )}
    </div>
  </Main>

  <Footer />
</Layout>
