---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import ThreadCard from "@/components/ThreadCard.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const isDev = import.meta.env.DEV;

const allThreads = await getCollection("threads", ({ data }) => !data.draft);

const sortedThreads = allThreads.sort((a, b) => {
  const dateA = a.data.modDatetime ?? a.data.pubDatetime;
  const dateB = b.data.modDatetime ?? b.data.pubDatetime;
  return new Date(dateB).getTime() - new Date(dateA).getTime();
});

const inProgressCount = sortedThreads.filter(t => t.data.status === "in-progress").length;
const checkpointCount = sortedThreads.filter(t => t.data.status === "checkpoint-reached").length;
const completedCount = sortedThreads.filter(t => t.data.status === "completed").length;
---

<Layout title={`${t.pages.threadsTitle} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />

  <Main pageTitle={t.pages.threadsTitle} pageDesc={t.pages.threadsDesc}>
    <!-- Minimal Filter Links Bar -->
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3 border-b border-border pb-3" id="thread-filters">
      <div class="flex flex-wrap items-center gap-2 sm:gap-4 text-xs sm:text-sm font-medium">
        <button
          data-filter="all"
          class="filter-btn active-filter text-accent font-semibold underline underline-offset-4"
        >
          All ({sortedThreads.length})
        </button>
        <span class="text-muted-foreground/40">•</span>
        <button
          data-filter="in-progress"
          class="filter-btn text-muted-foreground hover:text-foreground transition-colors"
        >
          In Progress ({inProgressCount})
        </button>
        <span class="text-muted-foreground/40">•</span>
        <button
          data-filter="checkpoint-reached"
          class="filter-btn text-muted-foreground hover:text-foreground transition-colors"
        >
          Checkpoints ({checkpointCount})
        </button>
        <span class="text-muted-foreground/40">•</span>
        <button
          data-filter="completed"
          class="filter-btn text-muted-foreground hover:text-foreground transition-colors"
        >
          Completed ({completedCount})
        </button>
      </div>

      {isDev && (
        <a
          href={getRelativeLocaleUrl(locale, "threads/editor")}
          class="inline-flex items-center gap-1 rounded-md border border-accent/40 bg-accent/10 px-2.5 py-1 text-xs font-semibold text-accent hover:bg-accent hover:text-accent-foreground transition-colors"
        >
          <span>Dev Editor 🛠️</span>
        </a>
      )}
    </div>

    <!-- Minimal Threads List -->
    <section id="threads-timeline">
      {sortedThreads.length > 0 ? (
        <ul class="divide-y divide-border/40">
          {sortedThreads.map(thread => (
            <div data-status={thread.data.status} class="thread-item-wrapper">
              <ThreadCard thread={thread} />
            </div>
          ))}
        </ul>
      ) : (
        <p class="py-8 text-center text-sm text-muted-foreground">No experiment threads found.</p>
      )}
    </section>
  </Main>

  <Footer />
</Layout>

<script>
  function setupFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>("#thread-filters .filter-btn");
    const threadItems = document.querySelectorAll<HTMLElement>(".thread-item-wrapper");

    buttons.forEach(btn => {
      btn.addEventListener("click", () => {
        const filter = btn.dataset.filter;

        buttons.forEach(b => {
          b.classList.remove("text-accent", "font-semibold", "underline", "underline-offset-4", "active-filter");
          b.classList.add("text-muted-foreground");
        });

        btn.classList.add("text-accent", "font-semibold", "underline", "underline-offset-4", "active-filter");
        btn.classList.remove("text-muted-foreground");

        threadItems.forEach(item => {
          if (filter === "all" || item.dataset.status === filter) {
            item.style.display = "";
          } else {
            item.style.display = "none";
          }
        });
      });
    });
  }

  setupFilters();
  document.addEventListener("astro:after-swap", setupFilters);
</script>
