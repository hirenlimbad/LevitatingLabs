---
import { getRelativeLocaleUrl } from "astro:i18n";
import "@pagefind/default-ui/css/ui.css";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getAssetPath } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

// Redirect to 404 page if `search` feature is not enabled
const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (config.features.search !== "pagefind" && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const backUrl = config.features.showBackButton
  ? `${Astro.url.pathname}`
  : getRelativeLocaleUrl(locale, "");

const pagefindBundlePath = getAssetPath("pagefind/");

const t = useTranslations(locale);
---

<Layout title={`${t.pages.searchTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.searchTitle} pageDesc={t.pages.searchDesc}>
    <div
      id="pagefind-search"
      transition:persist
      data-backurl={backUrl}
      data-bundle-path={pagefindBundlePath}
    >
    </div>
  </Main>

  <Footer />
</Layout>

<script>
  function initSearch() {
    const pageFindSearch: HTMLElement | null =
      document.querySelector("#pagefind-search");

    if (!pageFindSearch) return;

    const bundlePath = pageFindSearch?.dataset?.bundlePath;
    if (!bundlePath) return;

    const params = new URLSearchParams(window.location.search);

    const onIdle = window.requestIdleCallback || (cb => setTimeout(cb, 1));

    onIdle(async () => {
      // @ts-expect-error — Missing types for @pagefind/default-ui package.
      const { PagefindUI } = await import("@pagefind/default-ui");

      // Display warning inn dev mode
      if (import.meta.env.DEV) {
        pageFindSearch.innerHTML = `
            <div class="bg-muted/75 rounded p-4 space-y-4 mb-4">
              <p><strong>DEV mode Warning! </strong>You need to build the project at least once to see the search results during development.</p>
              <code class="block bg-black text-white px-2 py-1 rounded">pnpm run build</code>
            </div>
          `;
      }

      // Init pagefind ui
      const search = new PagefindUI({
        element: "#pagefind-search",
        bundlePath,
        showImages: false,
        showSubResults: true,
        processTerm: function (term: string) {
          params.set("q", term); // Update the `q` parameter in the URL
          history.replaceState(history.state, "", "?" + params.toString()); // Push the new URL without reloading

          const backUrl =
            pageFindSearch?.dataset?.backurl ?? window.location.pathname;
          sessionStorage.setItem("backUrl", `${backUrl}?${params.toString()}`);

          return term;
        },
        processResult: function (result: any) {
          const formatExcerpt = (text: string) => {
            if (!text) return text;
            return text
              // Strip callout tags & headers
              .replace(/\[!(NOTE|IMPORTANT|WARNING|TIP|CAUTION)\]/gi, "")
              .replace(/^>\s*/gm, "")

              // Clean up raw TeX / KaTeX math commands if indexed
              .replace(/\\text\s*\{([^}]+)\}/g, "$1")
              .replace(/\\mathrm\s*\{([^}]+)\}/g, "$1")
              .replace(/\\mathbf\s*\{([^}]+)\}/g, "$1")
              .replace(/\\mathcal\s*\{([^}]+)\}/g, "$1")
              .replace(/\\Delta/g, "Δ")
              .replace(/\\sigma/g, "σ")
              .replace(/\\alpha/g, "α")
              .replace(/\\beta/g, "β")
              .replace(/\\mu/g, "μ")
              .replace(/\\pi/g, "π")
              .replace(/\\eta/g, "η")
              .replace(/\\delta/g, "δ")
              .replace(/\\epsilon/g, "ε")
              .replace(/\\approx/g, "≈")
              .replace(/\\pm/g, "±")
              .replace(/\\cdot/g, "·")
              .replace(/\\ge/g, "≥")
              .replace(/\\le/g, "≤")
              .replace(/\\neq/g, "≠")
              .replace(/\\to/g, "→")
              .replace(/\\in/g, "∈")
              .replace(/\\notin/g, "∉")
              .replace(/\\cap/g, "∩")
              .replace(/\\cup/g, "∪")
              .replace(/\\infty/g, "∞")
              .replace(/\\forall/g, "∀")
              .replace(/\\exists/g, "∃")
              .replace(/\\sqrt\s*\{([^}]+)\}/g, "√($1)")
              .replace(/\\frac\s*\{([^}]+)\}\s*\{([^}]+)\}/g, "$1/$2")
              .replace(/\\\{/g, "{")
              .replace(/\\\}/g, "}")
              .replace(/\\\$/g, "$")
              .replace(/\$+/g, "")

              // Format code & bold / italic markdown
              .replace(/`([^`\n]+)`/g, '<code class="search-code">$1</code>')
              .replace(/`/g, "")
              .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
              .replace(/\*([^*]+)\*/g, "<em>$1</em>");
          };

          if (result.excerpt) {
            result.excerpt = formatExcerpt(result.excerpt);
          }
          if (result.sub_results) {
            result.sub_results.forEach((sub: any) => {
              if (sub.excerpt) {
                sub.excerpt = formatExcerpt(sub.excerpt);
              }
            });
          }
          return result;
        },
      });

      // If search param exists (eg: search?q=astro), trigger search
      const query = params.get("q");
      if (query) {
        search.triggerSearch(query);
      }

      // Reset search param if search input is cleared
      const searchInput = document.querySelector(".pagefind-ui__search-input");
      const clearButton = document.querySelector(".pagefind-ui__search-clear");
      searchInput?.addEventListener("input", resetSearchParam);
      clearButton?.addEventListener("click", resetSearchParam);

      function resetSearchParam(e: Event) {
        if ((e.target as HTMLInputElement)?.value.trim() === "") {
          history.replaceState(history.state, "", window.location.pathname);
        }
      }
    });
  }

  document.addEventListener("astro:after-swap", () => {
    const pagefindSearch = document.querySelector("#pagefind-search");

    // if pagefind search form already exists, don't initialize search component
    if (pagefindSearch && pagefindSearch.querySelector("form")) return;

    initSearch();
  });
  initSearch();
</script>

<style is:global>
  #pagefind-search {
    --pagefind-ui-font: var(--font-app);
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: var(--background);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-tag: var(--background);
    --pagefind-ui-border-radius: 0.5rem;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-image-border-radius: 8px;
    --pagefind-ui-image-box-ratio: 3 / 2;

    form::before {
      background-color: var(--foreground);
    }

    input {
      font-weight: 400;
      border: 1px solid var(--border);
      border-radius: 0.5rem;
    }

    input:focus-visible {
      outline: 2px solid var(--accent);
    }

    .pagefind-ui__result {
      border-bottom: 1px dashed var(--border);
      padding: 1.25rem 0;
    }

    .pagefind-ui__result:last-of-type {
      border-bottom: 0;
    }

    .pagefind-ui__result-title {
      font-size: 1.125rem;
      font-weight: 700;
      margin-bottom: 0.375rem;
    }

    .pagefind-ui__result-title a {
      color: var(--accent);
      outline-offset: 1px;
      outline-color: var(--accent);
      text-decoration-style: dashed;
      text-underline-offset: 4px;
    }

    .pagefind-ui__result-title a:hover {
      text-decoration-line: underline;
    }

    .pagefind-ui__result-title a:focus-visible,
    .pagefind-ui__search-clear:focus-visible {
      text-decoration-line: none;
      outline-width: 2px;
      outline-style: dashed;
    }

    .pagefind-ui__result-excerpt {
      font-size: 0.925rem;
      line-height: 1.6;
      color: var(--foreground);
      opacity: 0.9;
      margin-top: 0.375rem;
    }

    .pagefind-ui__result-excerpt mark,
    mark {
      background-color: rgba(238, 120, 30, 0.2);
      color: var(--accent);
      font-weight: 600;
      padding: 0.1rem 0.3rem;
      border-radius: 0.25rem;
    }

    .pagefind-ui__result-excerpt code,
    code.search-code {
      font-family: var(--font-google-sans-code, monospace);
      font-size: 0.85em;
      background-color: var(--muted);
      color: var(--foreground);
      border: 1px solid var(--border);
      padding: 0.15rem 0.35rem;
      border-radius: 0.25rem;
      word-break: break-word;
    }

    .pagefind-ui__result-excerpt strong {
      font-weight: 700;
      color: var(--foreground);
    }

    .pagefind-ui__result-excerpt em {
      font-style: italic;
    }

    .pagefind-ui__result-nested {
      margin-top: 0.75rem;
      padding-left: 1rem;
      border-left: 2px solid var(--border);
    }

    .pagefind-ui__result-nested .pagefind-ui__result-link {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--foreground);
    }

    .pagefind-ui__result-nested .pagefind-ui__result-link:hover {
      color: var(--accent);
    }

    .pagefind-ui__result-nested .pagefind-ui__result-link:before {
      content: "↳ ";
      font-family: system-ui;
      color: var(--muted-foreground);
    }
  }
</style>
