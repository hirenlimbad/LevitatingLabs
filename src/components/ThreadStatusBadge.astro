---
export interface Props {
  status: "in-progress" | "checkpoint-reached" | "completed" | "archived";
  size?: "sm" | "md" | "lg";
}

const { status = "in-progress" } = Astro.props;

const statusConfigs = {
  "in-progress": {
    label: "In Progress",
    color: "text-amber-500",
  },
  "checkpoint-reached": {
    label: "Checkpoint Reached",
    color: "text-emerald-500",
  },
  completed: {
    label: "Completed",
    color: "text-blue-500",
  },
  archived: {
    label: "Archived",
    color: "text-stone-400",
  },
};

const config = statusConfigs[status] || statusConfigs["in-progress"];
---

<span class="inline-flex items-center" title={config.label} aria-label={config.label}>
  {status === "in-progress" && (
    <svg xmlns="http://www.w3.org/2000/svg" class:list={["size-4 stroke-[2]", config.color]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10 2v7.314a2 2 0 0 1-.293 1.028l-4.414 7.725A2 2 0 0 0 7.028 21h9.944a2 2 0 0 0 1.735-2.933l-4.414-7.725A2 2 0 0 1 14 9.314V2"/>
      <path d="M8.5 2h7"/>
      <path d="M7 16h10"/>
    </svg>
  )}

  {status === "checkpoint-reached" && (
    <svg xmlns="http://www.w3.org/2000/svg" class:list={["size-4 stroke-[2]", config.color]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"/>
      <circle cx="12" cy="12" r="6"/>
      <circle cx="12" cy="12" r="2"/>
    </svg>
  )}

  {status === "completed" && (
    <svg xmlns="http://www.w3.org/2000/svg" class:list={["size-4 stroke-[2]", config.color]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
      <polyline points="22 4 12 14.01 9 11.01"/>
    </svg>
  )}

  {status === "archived" && (
    <svg xmlns="http://www.w3.org/2000/svg" class:list={["size-4 stroke-[2]", config.color]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="21 8 21 21 3 21 3 8"/>
      <rect x="1" y="3" width="22" height="5"/>
      <line x1="10" y1="12" x2="14" y2="12"/>
    </svg>
  )}
</span>
